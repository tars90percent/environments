# Accept explicitly allowed users in direct messages only.
ALLOWED_USER_IDS=
RANGER_DATA_DIR=/var/lib/ranger
AGENT_WORKSPACE=/var/lib/ranger/workspace
DSH_HOME=/var/lib/ranger/dsh
LARKSUITE_CLI_CONFIG_DIR=/var/lib/ranger/lark-cli
LARK_PROFILE=ranger
# Immutable release containing the root AGENTS.md.
RANGER_SOURCE_ROOT=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_REASONING_EFFORT=high
DEEPSEEK_MAX_TOKENS=16384
# Native service relies on systemd's explicit writable paths for OS confinement.
# For development outside that unit, use workspace-write or read-only.
DSH_PERMISSION_MODE=danger-full-access
RANGER_TURN_TIMEOUT_SECONDS=1800
# Supply DEEPSEEK_API_KEY separately in the private /etc/ranger/secrets.env.
