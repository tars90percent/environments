# CASE registry connection. On Railway, prefer the private service hostname and port.
CASE_REGISTRY_URL=
CASE_REGISTRY_HOST=
CASE_REGISTRY_PORT=3000

# The portal can read the catalog and append submission reviews only.
CASE_REGISTRY_CATALOG_TOKEN=
CASE_REGISTRY_REVIEW_TOKEN=

# Feishu organization OAuth.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_ALLOWED_TENANT_KEY=

# Public portal origin and signed-session secret.
PORTAL_BASE_URL=http://localhost:3000
PORTAL_SESSION_SECRET=
