# Optional lark-cli configuration profile dedicated to the agent.
LARK_PROFILE=

# Uses the already-installed Codex CLI during local development.
CODEX_PATH=codex

# During the pilot, respond in direct messages only. Set true to allow group
# mentions after the bot has been tested privately.
ALLOW_GROUP_CHATS=false

# Deliberate escape hatch for a later company-wide pilot. Keep false initially.
ALLOW_ALL_USERS=false

# Keep the agent's Codex workspace separate from the procurement workspace.
AGENT_WORKSPACE=.data/workspace

# Persistent mapping from Feishu conversations to Codex threads.
AGENT_STATE=.data/state.json

# Self-service Feishu user authorization. The active device-code handoff and QR
# images live beside AGENT_STATE by default. On Railway, keep all three paths on
# the persistent /data volume. "all" matches the broad lark-cli access used by
# this private pilot; replace it with comma-separated domains for least privilege.
LARK_AUTH_STATE=.data/authorization.json
LARK_AUTH_QR_DIR=.data/authorization-qr
LARK_AUTH_DOMAINS=all
LARK_AUTH_POLL_TIMEOUT_MS=45000

# Codex tool permissions. Keep these defaults for local development. In an
# isolated cloud container, full access makes the container the boundary.
CODEX_SANDBOX_MODE=read-only
CODEX_NETWORK_ACCESS=false
CODEX_WEB_SEARCH_MODE=disabled
CODEX_APPROVAL_POLICY=never
CODEX_APPROVALS_REVIEWER=user

# Optional comma-separated Feishu open_ids allowed to use the pilot.
# Leave empty only for a tightly controlled development app.
ALLOWED_USER_IDS=
