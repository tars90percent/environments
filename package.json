{
  "name": "feishu-codex-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A Feishu teammate powered by Codex.",
  "scripts": {
    "dev": "node --watch --import tsx src/index.ts",
    "build": "node node_modules/typescript/bin/tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "check": "node node_modules/typescript/bin/tsc --noEmit",
    "test": "node --import tsx --test test/**/*.test.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@larksuite/cli": "1.0.85",
    "@openai/codex-sdk": "0.147.0"
  },
  "devDependencies": {
    "@types/node": "latest",
    "tsx": "latest",
    "typescript": "latest"
  }
}
